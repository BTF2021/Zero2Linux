[node name="Name3" type="RichTextLabel" parent="Window/Settings/VBoxContainer/Despre"]
custom_minimum_size = Vector2(161, 0)
layout_mode = 2
theme_override_font_sizes/bold_italics_font_size = 17
theme_override_font_sizes/italics_font_size = 17
theme_override_font_sizes/mono_font_size = 17
theme_override_font_sizes/normal_font_size = 17
theme_override_font_sizes/bold_font_size = 17
text = "	 Zero2Linux este un proiect personal, creat pentru a-i invata pe cei mai putini familiarizati cu ecosistemul Linux sa foloseasca un desktop Linux.
	Desi Linux este foarte popular pentru servere, majoritatea nu au auzit despre Linux/ cred ca Linux este doar pentru cei foarte avansati (sau cei care \"nu isi apreciaza timpul\"). Zero2Linux incearca sa arate faptul ca Linux nu este (neaparat) foarte complicat si se pot face lucruri posibile si pe celelalte sisteme de operare, in multe cazuri chiar mai simplu.
	 Zero2Linux este gratis pentru toata lumea, dar este foarte apreciat daca ai dea stea (star) la proiect pe Github sau sa contribui prin raportarea bugurilor."
fit_content = true
scroll_active = false
shortcut_keys_enabled = false

